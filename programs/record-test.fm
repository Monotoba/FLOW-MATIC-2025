0001 USE EXTENSIONS RECORDS
0010 DEFINE RECORD Person
0020   name AS STRING
0030   age AS NUMBER
0040 END-RECORD
0050 SET p.name TO "Alice"
0060 SET p.age TO 30
0070 WRITE "Record test: " TO CONSOLE
0080 WRITE p.name TO CONSOLE
0090 WRITE " is " TO CONSOLE
0100 WRITE p.age TO CONSOLE
0110 WRITE " years old" TO CONSOLE
0120 STOP