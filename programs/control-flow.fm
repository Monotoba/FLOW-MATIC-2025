0001 USE EXTENSIONS CONSOLE-IO
0010 SET counter TO 1
0020 SET limit TO 5
0030 WRITE "Counting to " TO CONSOLE
0040 WRITE limit TO CONSOLE
0050 WRITE ":" TO CONSOLE
0060 loop:
0070   WRITE " " TO CONSOLE
0080   WRITE counter TO CONSOLE
0090   counter := counter + 1
0100 COMPARE counter TO limit
0110 JUMP TO loop UNLESS __COMPARE_RESULT
0120 WRITE " Done!" TO CONSOLE
0130 STOP