0001 USE EXTENSIONS CONSOLE-IO
0010 SET a TO 10
0020 SET b TO 5
0030 sum := a + b
0040 diff := a - b
0050 product := a * b
0060 quotient := a / b
0070 WRITE "Sum: " TO CONSOLE
0080 WRITE sum TO CONSOLE
0090 WRITE ", Difference: " TO CONSOLE
0100 WRITE diff TO CONSOLE
0110 WRITE ", Product: " TO CONSOLE
0120 WRITE product TO CONSOLE
0130 WRITE ", Quotient: " TO CONSOLE
0140 WRITE quotient TO CONSOLE
0150 STOP