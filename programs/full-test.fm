0001 * Comprehensive Flow-Matic Test
0002 USE EXTENSIONS CONSOLE-IO, RECORDS, COLLECTIONS, DATETIME
0003
0004 * Basic I/O
0005 INPUT "Enter your age: " FROM CONSOLE TO age
0006
0007 * Arithmetic
0008 SET x TO 100
0009 SET y TO 50
0010 sum := x + y
0011
0012 * Records
0013 DEFINE RECORD User
0014   name AS STRING
0015   score AS NUMBER
0016 END-RECORD
0017 SET user1.name TO "TestUser"
0018 SET user1.score TO sum
0019
0020 * Collections
0021 DEFINE COLLECTION scores OF NUMBER
0022 ADD TO scores VALUE user1.score
0023 ADD TO scores VALUE 75
0024
0025 * Output
0026 WRITE "User: " TO CONSOLE
0027 WRITE user1.name TO CONSOLE
0028 WRITE ", Age: " TO CONSOLE
0029 WRITE age TO CONSOLE
0030 WRITE ", Scores: " TO CONSOLE
0031 GET FROM scores AT 1 INTO firstScore
0032 WRITE firstScore TO CONSOLE
0033
0034 * Date/Time
0035 GET CURRENT-DATETIME INTO current
0036 WRITE ", Current datetime: " TO CONSOLE
0037 WRITE current TO CONSOLE
0038
0039 STOP